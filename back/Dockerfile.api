# syntax=docker/dockerfile:1

FROM golang:1.25-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/dmarket-target-bot \
    ./cmd/dmarket-target-bot

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -o 65532 -g 65532 /var/lib/targetbot

COPY --from=build /out/dmarket-target-bot /usr/local/bin/dmarket-target-bot

USER 65532:65532
WORKDIR /var/lib/targetbot

ENTRYPOINT ["/usr/local/bin/dmarket-target-bot"]
CMD ["-config", "/etc/targetbot/config.yaml", "-api", ":8080", "-api-only"]
